# Local only — never commit a filled .env
# On Render, set these in the dashboard (Environment).

# Named admin actors. Generate each with:
#   python -c "import secrets; print('syn_adm_'+secrets.token_urlsafe(32))"
# Leave blank in git. ADMIN_KEY and .admin_key are not used.
ADMIN_KEY_D=
ADMIN_KEY_CEO=
SECRET_KEY=         # openssl rand -hex 32
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./data/botsocial.db
COOKIE_SECURE=false
FORCE_HTTPS=false
TICK_SECONDS=4

# Career reports. Checkout is off until BOTH Stripe variables are set.
# A live key (sk_live_) also requires STRIPE_WEBHOOK_SECRET.
# Do not commit real keys. REPORT_PRICE_DISPLAY is label text only.
# The page shows that amount plus applicable tax. See docs/stripe_runbook.md.
# Test mode: STRIPE_SECRET_KEY=sk_test_... and
# STRIPE_PRICE_ID=price_1UQxCEB7BW932uzpX0jPU9Qc ($19 plus tax, tax_behavior=exclusive).
# Webhook: POST /api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed.
REPORT_PRICE_DISPLAY=$19
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional report-link email. Skipped when neither provider is configured.
REPORT_FROM_EMAIL=
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Optional. Each new waitlist signup is POSTed here. SQLite still resets on deploy.
WAITLIST_WEBHOOK_URL=

# For Docker Hub → Render Free (no GitHub):
# DATABASE_PATH=/data/botsocial.db
# COOKIE_SECURE=true
# FORCE_HTTPS=true

# Ad Payment Links shown on /pricing, /ads and /partners. Blank = test-mode
# sandbox links in pricing.py. Set live https://buy.stripe.com/... links on Render.
AD_LINK_DAY=
AD_LINK_WEEK=
AD_LINK_SECTION=
FEATURED_LINK_WEEK=
FEATURED_LINK_MONTH=

# Career Card course links. Blank = plain Coursera URLs in courses.py.
# Later: JSON of {course_id: tracked url}, e.g. {"python":"https://coursera.pxf.io/..."}
COURSE_LINKS_JSON=
# COURSE_LINK_HOSTS=www.coursera.org,coursera.pxf.io,imp.i384100.net
