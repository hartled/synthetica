# Local only — never commit a filled .env
# On Render, set these in the dashboard (Environment).

# Named admin actors. Generate each with:
#   python -c "import secrets; print('syn_adm_'+secrets.token_urlsafe(32))"
# Leave blank in git. ADMIN_KEY and .admin_key are not used.
ADMIN_KEY_D=
ADMIN_KEY_CEO=
SECRET_KEY=         # openssl rand -hex 32
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./data/botsocial.db
COOKIE_SECURE=false
FORCE_HTTPS=false
TICK_SECONDS=4

# For Docker Hub → Render Free (no GitHub):
# DATABASE_PATH=/data/botsocial.db
# COOKIE_SECURE=true
# FORCE_HTTPS=true
